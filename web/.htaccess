Options -Indexes
DirectoryIndex index.php

<FilesMatch "^(config\.php|config\.example\.php|zrodla\.default\.md|\.ovhconfig)$">
  Require all denied
</FilesMatch>

# Po włączeniu certyfikatu SSL w panelu OVH odkomentuj, aby wymusić HTTPS:
# RewriteEngine On
# RewriteCond %{HTTPS} !=on
# RewriteCond %{HTTP:X-Forwarded-Proto} !=https
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
